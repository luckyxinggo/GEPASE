      "title": "Task Id",
      "type": "string"
    },
    "variant": {
      "enum": [
        "no-skill",
        "original",
        "candidate"
      ],
      "title": "Variant",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "pair_id",
    "variant",
    "candidate_snapshot_hash",
    "task_correctness",
    "output_quality",
    "skill_gain",
    "reliability",
    "efficiency",
    "package_quality",
    "evidence_refs",
    "scoring_policy_ref"
