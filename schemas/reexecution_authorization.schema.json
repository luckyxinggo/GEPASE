{
  "additionalProperties": false,
  "description": "Explicit user checkpoint required beyond the frozen repair limit.",
  "properties": {
    "authorization_id": {
      "title": "Authorization Id",
      "type": "string"
    },
    "authorized_additional_reexecutions": {
      "maximum": 1,
      "minimum": 1,
      "title": "Authorized Additional Reexecutions",
      "type": "integer"
    },
    "authorized_at": {
      "format": "date-time",
      "title": "Authorized At",
      "type": "string"
    },
    "authorized_by": {
      "const": "user",
      "default": "user",
      "title": "Authorized By",
      "type": "string"
    },
    "checkpoint_ref": {
      "title": "Checkpoint Ref",
      "type": "string"
    },
    "checkpoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checkpoint Sha256",
      "type": "string"
    },
    "prior_reexecution_count": {
      "minimum": 1,
      "title": "Prior Reexecution Count",
      "type": "integer"
    },
    "reason_zh": {
      "minLength": 1,
      "title": "Reason Zh",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "work_id": {
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "authorization_id",
    "run_id",
    "work_id",
    "checkpoint_ref",
    "checkpoint_sha256",
    "prior_reexecution_count",
    "authorized_additional_reexecutions",
    "reason_zh",
    "authorized_at"
  ],
  "title": "ReexecutionAuthorization",
  "type": "object"
}
