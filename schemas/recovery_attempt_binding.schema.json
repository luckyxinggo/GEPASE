{
  "$defs": {
    "AgentAttemptKind": {
      "enum": [
        "initial_execution",
        "reexecution"
      ],
      "title": "AgentAttemptKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bind one immutable submission/workspace to one observed Host attempt.",
  "properties": {
    "attempt_kind": {
      "$ref": "#/$defs/AgentAttemptKind"
    },
    "binding_valid": {
      "const": true,
      "default": true,
      "title": "Binding Valid",
      "type": "boolean"
    },
    "context_id": {
      "minLength": 1,
      "title": "Context Id",
      "type": "string"
    },
    "host_attempt_accounting_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Host Attempt Accounting Hashes",
      "type": "object"
    },
    "host_attempt_accounting_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Host Attempt Accounting Ids",
      "type": "array"
    },
    "host_task_id": {
      "minLength": 1,
      "title": "Host Task Id",
      "type": "string"
    },
    "raw_workspace_ref": {
      "title": "Raw Workspace Ref",
      "type": "string"
    },
    "raw_workspace_tree_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Workspace Tree Hash",
      "type": "string"
    },
    "repair_attempt": {
      "title": "Repair Attempt",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_host_attempt_accounting_id": {
      "minLength": 1,
      "title": "Selected Host Attempt Accounting Id",
      "type": "string"
    },
    "source_artifact_root_ref": {
      "title": "Source Artifact Root Ref",
      "type": "string"
    },
    "source_submission_id": {
      "minLength": 1,
      "title": "Source Submission Id",
      "type": "string"
    },
    "source_submission_ref": {
      "title": "Source Submission Ref",
      "type": "string"
    },
    "source_submission_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Submission Sha256",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "work_id": {
      "minLength": 1,
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "work_id",
    "task_id",
    "attempt_kind",
    "repair_attempt",
    "source_submission_ref",
    "source_submission_sha256",
    "source_submission_id",
    "source_artifact_root_ref",
    "raw_workspace_ref",
    "raw_workspace_tree_hash",
    "host_task_id",
    "context_id",
    "selected_host_attempt_accounting_id",
    "host_attempt_accounting_ids",
    "host_attempt_accounting_hashes"
  ],
  "title": "RecoveryAttemptBinding",
  "type": "object"
}
