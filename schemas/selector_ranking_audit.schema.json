{
  "$defs": {
    "FeatureContribution": {
      "additionalProperties": false,
      "properties": {
        "contribution": {
          "title": "Contribution",
          "type": "number"
        },
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/FeatureGroup",
          "default": "relevance"
        },
        "raw_value": {
          "title": "Raw Value",
          "type": "number"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "feature",
        "raw_value",
        "weight",
        "contribution"
      ],
      "title": "FeatureContribution",
      "type": "object"
    },
    "FeatureGroup": {
      "enum": [
        "relevance",
        "exploration",
        "risk",
        "control"
      ],
      "title": "FeatureGroup",
      "type": "string"
    },
    "RankedSelection": {
      "additionalProperties": false,
      "properties": {
        "contributions": {
          "items": {
            "$ref": "#/$defs/FeatureContribution"
          },
          "title": "Contributions",
          "type": "array"
        },
        "eligibility_reasons": {
          "default": [
            "mutable_and_typed"
          ],
          "items": {
            "type": "string"
          },
          "title": "Eligibility Reasons",
          "type": "array"
        },
        "eligible": {
          "default": true,
          "title": "Eligible",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "high_blast_radius": {
          "default": false,
          "title": "High Blast Radius",
          "type": "boolean"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "score_breakdown": {
          "$ref": "#/$defs/SelectionScoreBreakdown"
        },
        "validation_intensity": {
          "$ref": "#/$defs/ValidationIntensity"
        }
      },
      "required": [
        "rank",
        "node_id",
        "path",
        "locator",
        "score",
        "contributions",
        "evidence_refs",
        "reason_code"
      ],
      "title": "RankedSelection",
      "type": "object"
    },
    "SelectionScoreBreakdown": {
      "additionalProperties": false,
      "properties": {
        "capped_ranking_risk_penalty": {
          "default": 0.0,
          "title": "Capped Ranking Risk Penalty",
          "type": "number"
        },
        "exploration": {
          "default": 0.0,
          "title": "Exploration",
          "type": "number"
        },
        "relevance": {
          "default": 0.0,
          "title": "Relevance",
          "type": "number"
        },
        "risk": {
          "default": 0.0,
          "title": "Risk",
          "type": "number"
        }
      },
      "title": "SelectionScoreBreakdown",
      "type": "object"
    },
    "ValidationIntensity": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/ValidationLevel",
          "default": "standard"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "required_checks": {
          "default": [
            "targeted_static",
            "package_reparse"
          ],
          "items": {
            "type": "string"
          },
          "title": "Required Checks",
          "type": "array"
        }
      },
      "title": "ValidationIntensity",
      "type": "object"
    },
    "ValidationLevel": {
      "enum": [
        "standard",
        "elevated",
        "full"
      ],
      "title": "ValidationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bounded view of the full ranking exported with proposal evidence.",
  "properties": {
    "executable_alternative": {
      "anyOf": [
        {
          "$ref": "#/$defs/RankedSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_node_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Selected Node Ids",
      "type": "array"
    },
    "top_k": {
      "items": {
        "$ref": "#/$defs/RankedSelection"
      },
      "minItems": 1,
      "title": "Top K",
      "type": "array"
    },
    "total_ranked": {
      "minimum": 1,
      "title": "Total Ranked",
      "type": "integer"
    }
  },
  "required": [
    "total_ranked",
    "selected_node_ids",
    "top_k"
  ],
  "title": "SelectorRankingAudit",
  "type": "object"
}
