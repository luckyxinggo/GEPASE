{
  "$defs": {
    "MergeEligibility": {
      "description": "Whether one pool row has sufficient explicit identity for merge selection.",
      "enum": [
        "unknown_legacy",
        "pending_contract",
        "eligible",
        "ineligible"
      ],
      "title": "MergeEligibility",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ancestor_candidate_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Ancestor Candidate Ids",
      "type": "array"
    },
    "branch_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch Id"
    },
    "branch_root_candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch Root Candidate Id"
    },
    "candidate_content_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Content Hash"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "exclusive_closure_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Exclusive Closure Ids",
      "type": "array"
    },
    "exclusive_component_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Exclusive Component Ids",
      "type": "array"
    },
    "exclusive_objective_keys": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Exclusive Objective Keys",
      "type": "array"
    },
    "exclusive_task_keys": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Exclusive Task Keys",
      "type": "array"
    },
    "failure_cluster_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Failure Cluster Ids",
      "type": "array"
    },
    "gate_0_1_passed": {
      "title": "Gate 0 1 Passed",
      "type": "boolean"
    },
    "lineage_root_candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lineage Root Candidate Id"
    },
    "merge_eligibility": {
      "$ref": "#/$defs/MergeEligibility",
      "default": "unknown_legacy"
    },
    "migrated_from_schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Migrated From Schema Version"
    },
    "not_deployable": {
      "default": true,
      "title": "Not Deployable",
      "type": "boolean"
    },
    "package_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Id"
    },
    "parent_candidate_id": {
      "title": "Parent Candidate Id",
      "type": "string"
    },
    "patch_id": {
      "title": "Patch Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_package_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
