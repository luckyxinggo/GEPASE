{
  "$defs": {
    "ComparatorCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "preference": {
          "enum": [
            "left",
            "right",
            "tie"
          ],
          "title": "Preference",
          "type": "string"
        },
        "rationale_zh": {
          "minLength": 1,
          "title": "Rationale Zh",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "preference",
        "rationale_zh"
      ],
      "title": "ComparatorCriterion",
      "type": "object"
    },
    "RoleRunProvenance": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "host": {
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "host_task_id": {
          "minLength": 1,
          "title": "Host Task Id",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "repair_attempt": {
          "default": false,
          "title": "Repair Attempt",
          "type": "boolean"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/UsageRecord"
        }
      },
      "required": [
        "host",
        "model",
        "context_id",
        "host_task_id",
        "usage",
        "started_at",
        "finished_at"
      ],
      "title": "RoleRunProvenance",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "token_count_kind": {
          "default": "unavailable",
          "enum": [
            "reported",
            "estimated",
            "unavailable"
          ],
          "title": "Token Count Kind",
          "type": "string"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comparator_work_id": {
      "title": "Comparator Work Id",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/ComparatorCriterion"
      },
      "title": "Criteria",
      "type": "array"
    },
    "rationale_zh": {
      "minLength": 1,
      "title": "Rationale Zh",
      "type": "string"
    },
    "role_run": {
      "$ref": "#/$defs/RoleRunProvenance"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submission_id": {
      "title": "Submission Id",
      "type": "string"
    },
    "winner": {
      "enum": [
        "left",
        "right",
        "tie"
      ],
      "title": "Winner",
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "comparator_work_id",
    "role_run",
    "winner",
    "confidence",
    "criteria",
    "rationale_zh"
  ],
  "title": "ComparatorSubmission",
  "type": "object"
}
