{
  "$defs": {
    "ContinuationAction": {
      "enum": [
        "continue",
        "stop_and_report",
        "abort_before_effect_claim"
      ],
      "title": "ContinuationAction",
      "type": "string"
    },
    "UsageAllowance": {
      "additionalProperties": false,
      "properties": {
        "active_wall_clock_ms": {
          "minimum": 0,
          "title": "Active Wall Clock Ms",
          "type": "integer"
        },
        "agent_calls": {
          "minimum": 0,
          "title": "Agent Calls",
          "type": "integer"
        },
        "candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "estimated_tokens": {
          "minimum": 0,
          "title": "Estimated Tokens",
          "type": "integer"
        },
        "proposals": {
          "default": 0,
          "minimum": 0,
          "title": "Proposals",
          "type": "integer"
        },
        "repairs": {
          "default": 0,
          "minimum": 0,
          "title": "Repairs",
          "type": "integer"
        }
      },
      "required": [
        "agent_calls",
        "estimated_tokens",
        "active_wall_clock_ms"
      ],
      "title": "UsageAllowance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ContinuationAction"
    },
    "approved_increment": {
      "$ref": "#/$defs/UsageAllowance"
    },
    "checkpoint_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checkpoint Hash",
      "type": "string"
    },
    "checkpoint_id": {
      "minLength": 1,
      "title": "Checkpoint Id",
      "type": "string"
    },
    "comment_zh": {
      "minLength": 1,
      "title": "Comment Zh",
      "type": "string"
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Hash",
      "type": "string"
    },
    "previous_decision_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Decision Hash"
    },
    "reviewer": {
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "run_id",
    "config_hash",
    "checkpoint_id",
    "checkpoint_hash",
    "evidence_hash",
    "action",
    "approved_increment",
    "reviewer",
    "comment_zh",
    "decided_at"
  ],
  "title": "BudgetContinuationDecision",
  "type": "object"
}
