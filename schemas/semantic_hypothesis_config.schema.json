{
  "$defs": {
    "SemanticConsumer": {
      "enum": [
        "failure_localization",
        "asi_explanation",
        "selector_top_k",
        "exploration_ordering",
        "patch_authorization",
        "target_set_expansion",
        "trusted_dependency_closure",
        "safety_closure",
        "merge_eligibility",
        "merge_conflict_resolution",
        "validation_gate"
      ],
      "title": "SemanticConsumer",
      "type": "string"
    },
    "SemanticRelationType": {
      "enum": [
        "implements",
        "explains",
        "constrains",
        "consumes",
        "produces",
        "validates",
        "conflicts_with"
      ],
      "title": "SemanticRelationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_consumers": {
      "default": [
        "failure_localization",
        "asi_explanation",
        "selector_top_k",
        "exploration_ordering"
      ],
      "items": {
        "$ref": "#/$defs/SemanticConsumer"
      },
      "title": "Allowed Consumers",
      "type": "array"
    },
    "allowed_relation_types": {
      "default": [
        "implements",
        "explains",
        "constrains",
        "consumes",
        "produces",
        "validates",
        "conflicts_with"
      ],
      "items": {
        "$ref": "#/$defs/SemanticRelationType"
      },
      "title": "Allowed Relation Types",
      "type": "array"
    },
    "analyzer_timeout_ms": {
      "default": 180000,
      "maximum": 600000,
      "minimum": 1,
      "title": "Analyzer Timeout Ms",
      "type": "integer"
    },
    "analyzer_token_budget": {
      "default": 12000,
      "maximum": 64000,
      "minimum": 1,
      "title": "Analyzer Token Budget",
      "type": "integer"
    },
    "config_id": {
      "default": "gh-p1-bounded-semantic-v1",
      "title": "Config Id",
      "type": "string"
    },
    "max_agent_calls": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Max Agent Calls",
      "type": "integer"
    },
    "max_allowed_nodes": {
      "default": 12,
      "maximum": 40,
      "minimum": 2,
      "title": "Max Allowed Nodes",
      "type": "integer"
    },
    "max_proposals_per_work": {
      "default": 6,
      "maximum": 12,
      "minimum": 1,
      "title": "Max Proposals Per Work",
      "type": "integer"
    },
    "max_relations_per_node": {
      "default": 3,
      "maximum": 6,
      "minimum": 1,
      "title": "Max Relations Per Node",
      "type": "integer"
    },
    "max_relations_per_node_pair": {
      "default": 2,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Relations Per Node Pair",
      "type": "integer"
    },
    "min_confidence": {
      "default": 0.45,
      "maximum": 1,
      "minimum": 0,
      "title": "Min Confidence",
      "type": "number"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selector_weight_cap": {
      "default": 0.35,
      "maximum": 0.5,
      "minimum": 0,
      "title": "Selector Weight Cap",
      "type": "number"
    }
  },
  "title": "SemanticHypothesisConfig",
  "type": "object"
}
