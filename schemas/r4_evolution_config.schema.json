{
  "$defs": {
    "ActiveSessionBudgetPolicy": {
      "additionalProperties": false,
      "properties": {
        "cumulative_usage_never_resets": {
          "const": true,
          "default": true,
          "title": "Cumulative Usage Never Resets",
          "type": "boolean"
        },
        "initial_tranche": {
          "$ref": "#/$defs/UsageAllowance"
        },
        "max_concurrency": {
          "default": 3,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "maximum_continuation_increment": {
          "$ref": "#/$defs/UsageAllowance"
        },
        "require_user_continuation": {
          "const": true,
          "default": true,
          "title": "Require User Continuation",
          "type": "boolean"
        },
        "required_barriers": {
          "items": {
            "$ref": "#/$defs/RuntimeBarrier"
          },
          "title": "Required Barriers",
          "type": "array"
        },
        "role_estimates": {
          "additionalProperties": {
            "$ref": "#/$defs/RoleBatchEstimate"
          },
          "minProperties": 1,
          "title": "Role Estimates",
          "type": "object"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "initial_tranche",
        "maximum_continuation_increment",
        "role_estimates",
        "required_barriers"
      ],
      "title": "ActiveSessionBudgetPolicy",
      "type": "object"
    },
    "ConditionalMergePolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_no_eligible_parent_set_terminal": {
          "const": true,
          "default": true,
          "title": "Allow No Eligible Parent Set Terminal",
          "type": "boolean"
        },
        "enumerate_all_train_admitted_branches": {
          "const": true,
          "default": true,
          "title": "Enumerate All Train Admitted Branches",
          "type": "boolean"
        },
        "forbid_cross_package_merge": {
          "const": true,
          "default": true,
          "title": "Forbid Cross Package Merge",
          "type": "boolean"
        },
        "forbid_held_out_selection": {
          "const": true,
          "default": true,
          "title": "Forbid Held Out Selection",
          "type": "boolean"
        },
        "materialize_when_eligible": {
          "const": true,
          "default": true,
          "title": "Materialize When Eligible",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "ConditionalMergePolicy",
      "type": "object"
    },
    "MinibatchPolicy": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_samples": {
          "default": 2000,
          "minimum": 100,
          "title": "Bootstrap Samples",
          "type": "integer"
        },
        "maximum_loss_fraction": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Loss Fraction",
          "type": "number"
        },
        "minimum_mean_delta": {
          "default": 0.0,
          "title": "Minimum Mean Delta",
          "type": "number"
        },
        "rejection_delta": {
          "default": -0.02,
          "maximum": 0,
          "title": "Rejection Delta",
          "type": "number"
        },
        "seed": {
          "default": 42,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "MinibatchPolicy",
      "type": "object"
    },
    "PatchEditBudget": {
      "additionalProperties": false,
      "properties": {
        "allow_file_topology_edits": {
          "default": true,
          "title": "Allow File Topology Edits",
          "type": "boolean"
        },
        "allow_script_edits": {
          "default": true,
          "title": "Allow Script Edits",
          "type": "boolean"
        },
        "max_added_files": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Added Files",
          "type": "integer"
        },
        "max_changed_files": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Changed Files",
          "type": "integer"
        },
        "max_deleted_files": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Deleted Files",
          "type": "integer"
        },
        "max_operations": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Operations",
          "type": "integer"
        },
        "max_total_replacement_chars": {
          "default": 12000,
          "maximum": 200000,
          "minimum": 1,
          "title": "Max Total Replacement Chars",
          "type": "integer"
        }
      },
      "title": "PatchEditBudget",
      "type": "object"
    },
    "RelativeEfficiencyPolicy": {
      "additionalProperties": false,
      "description": "Versioned held-out resource policy measured relative to original Skill.",
      "properties": {
        "aggregate": {
          "const": "median_per_axis_then_equal_weight_mean",
          "default": "median_per_axis_then_equal_weight_mean",
          "title": "Aggregate",
          "type": "string"
        },
        "artifact_size_mode": {
          "default": "report_only",
          "enum": [
            "report_only",
            "registered_constraint"
          ],
          "title": "Artifact Size Mode",
          "type": "string"
        },
        "comparable_axes": {
          "default": [
            "duration_ms",
            "tool_calls",
            "tokens"
          ],
          "items": {
            "enum": [
              "duration_ms",
              "tool_calls",
              "tokens",
              "artifact_size_bytes"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Comparable Axes",
          "type": "array"
        },
        "frontier_method": {
          "const": "pareto_layers",
          "default": "pareto_layers",
          "title": "Frontier Method",
          "type": "string"
        },
        "frontier_objectives": {
          "default": [
            "validation_primary_delta",
            "relative_efficiency_score"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Frontier Objectives",
          "type": "array"
        },
        "frontier_tie_break": {
          "default": [
            "validation_primary_delta_desc",
            "relative_efficiency_score_desc",
            "candidate_id_asc"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Frontier Tie Break",
          "type": "array"
        },
        "max_relative_cost_ratio": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "title": "Max Relative Cost Ratio",
          "type": "number"
        },
        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "policy_id": {
          "const": "relative_efficiency_v2",
          "default": "relative_efficiency_v2",
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score_mapping": {
          "const": "one_over_one_plus_ratio",
          "default": "one_over_one_plus_ratio",
          "title": "Score Mapping",
          "type": "string"
        },
        "unknown_efficiency_policy": {
          "const": "no_cross_availability_dominance_known_first_on_tie",
          "default": "no_cross_availability_dominance_known_first_on_tie",
          "title": "Unknown Efficiency Policy",
          "type": "string"
        }
      },
      "required": [
        "policy_hash"
      ],
      "title": "RelativeEfficiencyPolicy",
      "type": "object"
    },
    "RoleBatchEstimate": {
      "additionalProperties": false,
      "properties": {
        "max_estimated_tokens_per_work": {
          "minimum": 1,
          "title": "Max Estimated Tokens Per Work",
          "type": "integer"
        },
        "max_repair_attempts_per_work": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Repair Attempts Per Work",
          "type": "integer"
        },
        "timeout_ms_per_work": {
          "minimum": 1,
          "title": "Timeout Ms Per Work",
          "type": "integer"
        }
      },
      "required": [
        "max_estimated_tokens_per_work",
        "timeout_ms_per_work"
      ],
      "title": "RoleBatchEstimate",
      "type": "object"
    },
    "RoleTimeouts": {
      "additionalProperties": false,
      "properties": {
        "comparator": {
          "minimum": 1,
          "title": "Comparator",
          "type": "integer"
        },
        "executor": {
          "minimum": 1,
          "title": "Executor",
          "type": "integer"
        },
        "independent_grader": {
          "minimum": 1,
          "title": "Independent Grader",
          "type": "integer"
        },
        "proposal": {
          "minimum": 1,
          "title": "Proposal",
          "type": "integer"
        },
        "reflection": {
          "minimum": 1,
          "title": "Reflection",
          "type": "integer"
        }
      },
      "required": [
        "proposal",
        "executor",
        "independent_grader",
        "comparator",
        "reflection"
      ],
      "title": "RoleTimeouts",
      "type": "object"
    },
    "RunLifecyclePolicy": {
      "additionalProperties": false,
      "properties": {
        "initial_mode": {
          "const": "create_new",
          "default": "create_new",
          "title": "Initial Mode",
          "type": "string"
        },
        "reject_terminal_resume": {
          "const": true,
          "default": true,
          "title": "Reject Terminal Resume",
          "type": "boolean"
        },
        "require_typed_checkpoint": {
          "const": true,
          "default": true,
          "title": "Require Typed Checkpoint",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "strict_create_open_resume": {
          "const": true,
          "default": true,
          "title": "Strict Create Open Resume",
          "type": "boolean"
        }
      },
      "title": "RunLifecyclePolicy",
      "type": "object"
    },
    "RuntimeBarrier": {
      "enum": [
        "package_compiled",
        "reference_execution_complete",
        "reference_sealed",
        "proposal_scope_ready",
        "candidate_train_complete",
        "candidate_validation_complete",
        "merge_resolved",
        "before_final_report",
        "budget_limit",
        "post_recovery_checkpoint"
      ],
      "title": "RuntimeBarrier",
      "type": "string"
    },
    "RuntimeBudget": {
      "additionalProperties": false,
      "properties": {
        "max_agent_calls": {
          "minimum": 1,
          "title": "Max Agent Calls",
          "type": "integer"
        },
        "max_candidates": {
          "minimum": 3,
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_concurrency": {
          "maximum": 32,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "max_estimated_tokens": {
          "minimum": 1,
          "title": "Max Estimated Tokens",
          "type": "integer"
        },
        "max_proposals": {
          "minimum": 2,
          "title": "Max Proposals",
          "type": "integer"
        },
        "max_repair_attempts_per_work": {
          "maximum": 2,
          "minimum": 0,
          "title": "Max Repair Attempts Per Work",
          "type": "integer"
        },
        "max_wall_clock_seconds": {
          "minimum": 1,
          "title": "Max Wall Clock Seconds",
          "type": "integer"
        },
        "role_timeout_seconds": {
          "$ref": "#/$defs/RoleTimeouts"
        },
        "stop_semantics": {
          "minLength": 1,
          "title": "Stop Semantics",
          "type": "string"
        }
      },
      "required": [
        "max_concurrency",
        "role_timeout_seconds",
        "max_repair_attempts_per_work",
        "max_proposals",
        "max_candidates",
        "max_agent_calls",
        "max_estimated_tokens",
        "max_wall_clock_seconds",
        "stop_semantics"
      ],
      "title": "RuntimeBudget",
      "type": "object"
    },
    "SelectorGraphPolicy": {
      "additionalProperties": false,
      "description": "Controls which trusted graph layers the mutation selector may consume.",
      "properties": {
        "mode": {
          "default": "static",
          "enum": [
            "static",
            "static_observed"
          ],
          "title": "Mode",
          "type": "string"
        },
        "require_observed_when_access_present": {
          "const": true,
          "default": true,
          "title": "Require Observed When Access Present",
          "type": "boolean"
        },
        "require_sealed_typed_access": {
          "const": true,
          "default": true,
          "title": "Require Sealed Typed Access",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_hypotheses_enabled": {
          "const": false,
          "default": false,
          "description": "Deprecated compatibility sentinel. Active selector graphs are static+observed only; sealed GH-P1 semantic artifacts are read-only.",
          "title": "Semantic Hypotheses Enabled",
          "type": "boolean"
        },
        "top_k_audit_limit": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Top K Audit Limit",
          "type": "integer"
        }
      },
      "title": "SelectorGraphPolicy",
      "type": "object"
    },
    "UsageAllowance": {
      "additionalProperties": false,
      "properties": {
        "active_wall_clock_ms": {
          "minimum": 0,
          "title": "Active Wall Clock Ms",
          "type": "integer"
        },
        "agent_calls": {
          "minimum": 0,
          "title": "Agent Calls",
          "type": "integer"
        },
        "candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "estimated_tokens": {
          "minimum": 0,
          "title": "Estimated Tokens",
          "type": "integer"
        },
        "proposals": {
          "default": 0,
          "minimum": 0,
          "title": "Proposals",
          "type": "integer"
        },
        "repairs": {
          "default": 0,
          "minimum": 0,
          "title": "Repairs",
          "type": "integer"
        }
      },
      "required": [
        "agent_calls",
        "estimated_tokens",
        "active_wall_clock_ms"
      ],
      "title": "UsageAllowance",
      "type": "object"
    },
    "ValidationPolicy": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_samples": {
          "default": 5000,
          "minimum": 100,
          "title": "Bootstrap Samples",
          "type": "integer"
        },
        "category_regression_floor": {
          "default": -0.05,
          "maximum": 0,
          "title": "Category Regression Floor",
          "type": "number"
        },
        "high_risk_regression_floor": {
          "default": 0.0,
          "maximum": 0,
          "title": "High Risk Regression Floor",
          "type": "number"
        },
        "minimum_primary_delta": {
          "default": 0.0,
          "title": "Minimum Primary Delta",
          "type": "number"
        },
        "quality_noninferiority_margin": {
          "default": 0.0,
          "minimum": 0,
          "title": "Quality Noninferiority Margin",
          "type": "number"
        },
        "secondary_minimum_effect": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Secondary Minimum Effect",
          "type": "object"
        },
        "secondary_regression_floor": {
          "default": -0.01,
          "maximum": 0,
          "title": "Secondary Regression Floor",
          "type": "number"
        },
        "seed": {
          "default": 42,
          "title": "Seed",
          "type": "integer"
        },
        "task_score_secondary_minimum_effect": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Task Score Secondary Minimum Effect",
          "type": "object"
        }
      },
      "title": "ValidationPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_session_budget_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActiveSessionBudgetPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "branch_count": {
      "minimum": 2,
      "title": "Branch Count",
      "type": "integer"
    },
    "candidate_reflection_limit": {
      "const": 1,
      "default": 1,
      "title": "Candidate Reflection Limit",
      "type": "integer"
    },
    "conditional_merge_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConditionalMergePolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "efficiency_policy_mode": {
      "default": "relative_v2",
      "enum": [
        "v1_legacy",
        "relative_v2"
      ],
      "title": "Efficiency Policy Mode",
      "type": "string"
    },
    "enable_e1": {
      "const": false,
      "default": false,
      "title": "Enable E1",
      "type": "boolean"
    },
    "forbid_cross_package_merge": {
      "const": true,
      "default": true,
      "title": "Forbid Cross Package Merge",
      "type": "boolean"
    },
    "frozen_plan_ref": {
      "title": "Frozen Plan Ref",
      "type": "string"
    },
    "host": {
      "title": "Host",
      "type": "string"
    },
    "host_policy": {
      "title": "Host Policy",
      "type": "string"
    },
    "lifecycle_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunLifecyclePolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "package_graph_ref": {
      "title": "Package Graph Ref",
      "type": "string"
    },
    "package_ref": {
      "title": "Package Ref",
      "type": "string"
    },
    "patch_budget": {
      "$ref": "#/$defs/PatchEditBudget"
    },
    "provider_snapshot": {
      "title": "Provider Snapshot",
      "type": "string"
    },
    "reference_run_ref": {
      "title": "Reference Run Ref",
      "type": "string"
    },
    "reference_variant": {
      "enum": [
        "original",
        "candidate"
      ],
      "title": "Reference Variant",
      "type": "string"
    },
    "relative_efficiency_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/RelativeEfficiencyPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "require_ab_ba_comparator": {
      "const": true,
      "default": true,
      "title": "Require Ab Ba Comparator",
      "type": "boolean"
    },
    "require_same_package_merge": {
      "const": true,
      "default": true,
      "title": "Require Same Package Merge",
      "type": "boolean"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "runtime_budget": {
      "$ref": "#/$defs/RuntimeBudget"
    },
    "runtime_environment_fingerprint": {
      "title": "Runtime Environment Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "enum": [
        "1.0.0",
        "2.0.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_policy_ref": {
      "title": "Scoring Policy Ref",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "selector": {
      "enum": [
        "graph",
        "trace",
        "round_robin",
        "random"
      ],
      "title": "Selector",
      "type": "string"
    },
    "selector_graph_policy": {
      "$ref": "#/$defs/SelectorGraphPolicy",
      "default": {
        "mode": "static",
        "require_observed_when_access_present": true,
        "require_sealed_typed_access": true,
        "schema_version": "1.0.0",
        "semantic_hypotheses_enabled": false,
        "top_k_audit_limit": 10
      }
    },
    "selector_target_limit": {
      "maximum": 2,
      "minimum": 1,
      "title": "Selector Target Limit",
      "type": "integer"
    },
    "timeout_seconds": {
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "tool_policy_fingerprint": {
      "title": "Tool Policy Fingerprint",
      "type": "string"
    },
    "train_policy": {
      "$ref": "#/$defs/MinibatchPolicy"
    },
    "validation_policy": {
      "$ref": "#/$defs/ValidationPolicy"
    }
  },
  "required": [
    "run_id",
    "package_ref",
    "package_graph_ref",
    "frozen_plan_ref",
    "scoring_policy_ref",
    "reference_run_ref",
    "reference_variant",
    "host",
    "model",
    "provider_snapshot",
    "runtime_environment_fingerprint",
    "tool_policy_fingerprint",
    "host_policy",
    "seed",
    "timeout_seconds",
    "branch_count",
    "selector",
    "selector_target_limit",
    "runtime_budget",
    "patch_budget",
    "train_policy",
    "validation_policy"
  ],
  "title": "R4EvolutionConfig",
  "type": "object"
}
