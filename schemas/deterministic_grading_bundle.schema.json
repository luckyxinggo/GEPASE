{
  "$defs": {
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "title": "Assertion Id",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "measurements": {
          "additionalProperties": true,
          "title": "Measurements",
          "type": "object"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "assertion_id",
        "family",
        "passed",
        "weight"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "GifInspection": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "title": "Artifact Ref",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "contact_sheet_ref": {
          "title": "Contact Sheet Ref",
          "type": "string"
        },
        "effective_fps": {
          "minimum": 0,
          "title": "Effective Fps",
          "type": "number"
        },
        "file_size_bytes": {
          "minimum": 1,
          "title": "File Size Bytes",
          "type": "integer"
        },
        "first_last_pixel_delta": {
          "minimum": 0,
          "title": "First Last Pixel Delta",
          "type": "number"
        },
        "frame_count": {
          "minimum": 1,
          "title": "Frame Count",
          "type": "integer"
        },
        "frame_durations_ms": {
          "items": {
            "type": "integer"
          },
          "title": "Frame Durations Ms",
          "type": "array"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "loop_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loop Count"
        },
        "mean_adjacent_pixel_delta": {
          "minimum": 0,
          "title": "Mean Adjacent Pixel Delta",
          "type": "number"
        },
        "measurements_ref": {
          "title": "Measurements Ref",
          "type": "string"
        },
        "total_duration_ms": {
          "minimum": 0,
          "title": "Total Duration Ms",
          "type": "integer"
        },
        "unique_frame_count": {
          "minimum": 1,
          "title": "Unique Frame Count",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "artifact_ref",
        "artifact_sha256",
        "width",
        "height",
        "frame_count",
        "unique_frame_count",
        "total_duration_ms",
        "frame_durations_ms",
        "effective_fps",
        "file_size_bytes",
        "mean_adjacent_pixel_delta",
        "first_last_pixel_delta",
        "contact_sheet_ref",
        "measurements_ref"
      ],
      "title": "GifInspection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertion_results": {
      "items": {
        "$ref": "#/$defs/AssertionResult"
      },
      "title": "Assertion Results",
      "type": "array"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "e3_record_id": {
      "title": "E3 Record Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "inspection": {
      "$ref": "#/$defs/GifInspection"
    },
    "oracle_ref": {
      "title": "Oracle Ref",
      "type": "string"
    },
    "oracle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Oracle Sha256",
      "type": "string"
    },
    "pair_id": {
      "title": "Pair Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_record_id": {
      "title": "Source Record Id",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "variant": {
      "enum": [
        "no-skill",
        "original",
        "candidate"
      ],
      "title": "Variant",
      "type": "string"
    },
    "weighted_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Weighted Score",
      "type": "number"
    }
  },
  "required": [
    "bundle_id",
    "task_id",
    "pair_id",
    "variant",
    "source_record_id",
    "e3_record_id",
    "oracle_ref",
    "oracle_sha256",
    "inspection",
    "assertion_results",
    "weighted_score"
  ],
  "title": "DeterministicGradingBundle",
  "type": "object"
}
