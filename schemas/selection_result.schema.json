{
  "$defs": {
    "AttributionScope": {
      "enum": [
        "exact_node",
        "path_fallback",
        "none"
      ],
      "title": "AttributionScope",
      "type": "string"
    },
    "FeatureContribution": {
      "additionalProperties": false,
      "properties": {
        "attribution_scope": {
          "$ref": "#/$defs/AttributionScope",
          "default": "none"
        },
        "contribution": {
          "title": "Contribution",
          "type": "number"
        },
        "fallback_decay": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Fallback Decay",
          "type": "number"
        },
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/FeatureGroup",
          "default": "relevance"
        },
        "raw_value": {
          "title": "Raw Value",
          "type": "number"
        },
        "source_node_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Node Ids",
          "type": "array"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "feature",
        "raw_value",
        "weight",
        "contribution"
      ],
      "title": "FeatureContribution",
      "type": "object"
    },
    "FeatureGroup": {
      "enum": [
        "relevance",
        "exploration",
        "risk",
        "control"
      ],
      "title": "FeatureGroup",
      "type": "string"
    },
    "RankedSelection": {
      "additionalProperties": false,
      "properties": {
        "contributions": {
          "items": {
            "$ref": "#/$defs/FeatureContribution"
          },
          "title": "Contributions",
          "type": "array"
        },
        "eligibility_reasons": {
          "default": [
            "mutable_and_typed"
          ],
          "items": {
            "type": "string"
          },
          "title": "Eligibility Reasons",
          "type": "array"
        },
        "eligible": {
          "default": true,
          "title": "Eligible",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "high_blast_radius": {
          "default": false,
          "title": "High Blast Radius",
          "type": "boolean"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "score_breakdown": {
          "$ref": "#/$defs/SelectionScoreBreakdown"
        },
        "validation_intensity": {
          "$ref": "#/$defs/ValidationIntensity"
        }
      },
      "required": [
        "rank",
        "node_id",
        "path",
        "locator",
        "score",
        "contributions",
        "evidence_refs",
        "reason_code"
      ],
      "title": "RankedSelection",
      "type": "object"
    },
    "SelectionScoreBreakdown": {
      "additionalProperties": false,
      "properties": {
        "capped_ranking_risk_penalty": {
          "default": 0.0,
          "title": "Capped Ranking Risk Penalty",
          "type": "number"
        },
        "exploration": {
          "default": 0.0,
          "title": "Exploration",
          "type": "number"
        },
        "relevance": {
          "default": 0.0,
          "title": "Relevance",
          "type": "number"
        },
        "risk": {
          "default": 0.0,
          "title": "Risk",
          "type": "number"
        }
      },
      "title": "SelectionScoreBreakdown",
      "type": "object"
    },
    "SelectorKind": {
      "enum": [
        "random",
        "round_robin",
        "trace_only",
        "graph_guided"
      ],
      "title": "SelectorKind",
      "type": "string"
    },
    "ValidationIntensity": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/ValidationLevel",
          "default": "standard"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "required_checks": {
          "default": [
            "targeted_static",
            "package_reparse"
          ],
          "items": {
            "type": "string"
          },
          "title": "Required Checks",
          "type": "array"
        }
      },
      "title": "ValidationIntensity",
      "type": "object"
    },
    "ValidationLevel": {
      "enum": [
        "standard",
        "elevated",
        "full"
      ],
      "title": "ValidationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alternatives": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RankedSelection"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "deterministic_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deterministic Fingerprint",
      "type": "string"
    },
    "eligible_nodes": {
      "minimum": 1,
      "title": "Eligible Nodes",
      "type": "integer"
    },
    "iteration": {
      "title": "Iteration",
      "type": "integer"
    },
    "requested_limit": {
      "minimum": 1,
      "title": "Requested Limit",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "selected": {
      "items": {
        "$ref": "#/$defs/RankedSelection"
      },
      "minItems": 1,
      "title": "Selected",
      "type": "array"
    },
    "selector": {
      "$ref": "#/$defs/SelectorKind"
    }
  },
  "required": [
    "selector",
    "seed",
    "iteration",
    "requested_limit",
    "selected",
    "eligible_nodes",
    "deterministic_fingerprint"
  ],
  "title": "SelectionResult",
  "type": "object"
}
