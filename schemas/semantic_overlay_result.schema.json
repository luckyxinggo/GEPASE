{
  "$defs": {
    "SemanticDecisionStatus": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "SemanticDecisionStatus",
      "type": "string"
    },
    "SemanticRelationDecision": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "edge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Id"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "relation_type": {
          "$ref": "#/$defs/SemanticRelationType"
        },
        "source_node_id": {
          "title": "Source Node Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SemanticDecisionStatus"
        },
        "target_node_id": {
          "title": "Target Node Id",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "status",
        "relation_type",
        "source_node_id",
        "target_node_id",
        "confidence",
        "reason_codes"
      ],
      "title": "SemanticRelationDecision",
      "type": "object"
    },
    "SemanticRelationType": {
      "enum": [
        "implements",
        "explains",
        "constrains",
        "consumes",
        "produces",
        "validates",
        "conflicts_with"
      ],
      "title": "SemanticRelationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "items": {
        "$ref": "#/$defs/SemanticRelationDecision"
      },
      "title": "Accepted",
      "type": "array"
    },
    "analyzer_work_id": {
      "title": "Analyzer Work Id",
      "type": "string"
    },
    "failure_cluster_id": {
      "title": "Failure Cluster Id",
      "type": "string"
    },
    "layer_counts_after": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Layer Counts After",
      "type": "object"
    },
    "layer_counts_before": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Layer Counts Before",
      "type": "object"
    },
    "layered_graph_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Layered Graph Fingerprint",
      "type": "string"
    },
    "package_id": {
      "title": "Package Id",
      "type": "string"
    },
    "package_snapshot_hash": {
      "title": "Package Snapshot Hash",
      "type": "string"
    },
    "rejected": {
      "items": {
        "$ref": "#/$defs/SemanticRelationDecision"
      },
      "title": "Rejected",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_edge_ids": {
      "items": {
        "type": "string"
      },
      "title": "Semantic Edge Ids",
      "type": "array"
    },
    "source_graph_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Graph Fingerprint",
      "type": "string"
    },
    "source_node_count_unchanged": {
      "title": "Source Node Count Unchanged",
      "type": "boolean"
    },
    "submission_id": {
      "title": "Submission Id",
      "type": "string"
    },
    "trusted_graph_unchanged": {
      "title": "Trusted Graph Unchanged",
      "type": "boolean"
    }
  },
  "required": [
    "analyzer_work_id",
    "submission_id",
    "package_id",
    "package_snapshot_hash",
    "failure_cluster_id",
    "accepted",
    "rejected",
    "semantic_edge_ids",
    "layer_counts_before",
    "layer_counts_after",
    "trusted_graph_unchanged",
    "source_node_count_unchanged",
    "source_graph_fingerprint",
    "layered_graph_fingerprint"
  ],
  "title": "SemanticOverlayResult",
  "type": "object"
}
