  "additionalProperties": false,
  "properties": {
    "base_candidate_id": {
      "title": "Base Candidate Id",
      "type": "string"
    },
    "base_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Content Hash",
      "type": "string"
    },
    "base_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Snapshot Hash",
      "type": "string"
    },
    "edit_budget": {
      "$ref": "#/$defs/PatchEditBudget"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_file": "#/$defs/AddFile",
            "delete_file": "#/$defs/DeleteFile",
            "insert_reference": "#/$defs/InsertReference",
            "replace_markdown_block": "#/$defs/ReplaceMarkdownBlock",
            "replace_python_function": "#/$defs/ReplacePythonFunction",
            "replace_text_file": "#/$defs/ReplaceTextFile",
            "update_frontmatter": "#/$defs/UpdateFrontmatter"
          },
          "propertyName": "op"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ReplaceMarkdownBlock"
          },
          {
            "$ref": "#/$defs/InsertReference"
          },
          {
            "$ref": "#/$defs/UpdateFrontmatter"
          },
          {
            "$ref": "#/$defs/ReplacePythonFunction"
          },
          {
            "$ref": "#/$defs/ReplaceTextFile"
          },
          {
            "$ref": "#/$defs/AddFile"
          },
          {
            "$ref": "#/$defs/DeleteFile"
          }
        ]
      },
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "patch_id": {
      "title": "Patch Id",
      "type": "string"
    },
    "proposal_work_id": {
      "title": "Proposal Work Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_node_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Node Ids",
      "type": "array"
    },
    "selector": {
      "title": "Selector",
      "type": "string"
    },
    "summary": {
      "maxLength": 1500,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "patch_id",
    "proposal_work_id",
    "base_candidate_id",
    "base_snapshot_hash",
    "base_content_hash",
    "selector",
    "selected_node_ids",
    "operations",
    "edit_budget",
    "evidence_refs",
    "summary"
  ],
  "title": "PackagePatch",
  "type": "object"
