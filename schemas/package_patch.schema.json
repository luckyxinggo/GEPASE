    "PatchEditBudget": {
      "additionalProperties": false,
      "properties": {
        "allow_file_topology_edits": {
          "default": true,
          "title": "Allow File Topology Edits",
          "type": "boolean"
        },
        "allow_script_edits": {
          "default": true,
          "title": "Allow Script Edits",
          "type": "boolean"
        },
        "max_added_files": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Added Files",
          "type": "integer"
        },
        "max_changed_files": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Changed Files",
          "type": "integer"
        },
        "max_deleted_files": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Deleted Files",
          "type": "integer"
        },
        "max_operations": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Operations",
          "type": "integer"
        },
        "max_total_replacement_chars": {
          "default": 12000,
          "maximum": 200000,
          "minimum": 1,
          "title": "Max Total Replacement Chars",
          "type": "integer"
        }
      },
      "title": "PatchEditBudget",
      "type": "object"
    },
    "RegressionRisk": {
      "enum": [
        "low",
        "medium",
        "high"
