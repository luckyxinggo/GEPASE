{
  "$defs": {
    "AddFile": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "executable": {
          "default": false,
          "title": "Executable",
          "type": "boolean"
        },
        "expected_benefit": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Expected Benefit",
          "type": "string"
        },
        "op": {
          "const": "add_file",
          "title": "Op",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^op-[a-zA-Z0-9._-]+$",
          "title": "Operation Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "precondition_hash": {
          "default": "absent",
          "title": "Precondition Hash",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "regression_risk": {
          "$ref": "#/$defs/RegressionRisk"
        },
        "target_node_id": {
          "default": null,
          "title": "Target Node Id",
          "type": "null"
        }
      },
      "required": [
        "operation_id",
        "path",
        "evidence_refs",
        "expected_benefit",
        "regression_risk",
        "rationale",
        "op",
        "content"
      ],
      "title": "AddFile",
      "type": "object"
    },
