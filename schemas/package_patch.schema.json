          "type": "string"
        },
        "orphan_evidence_ref": {
          "minLength": 1,
          "title": "Orphan Evidence Ref",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "precondition_hash": {
          "pattern": "^(?:[0-9a-f]{64}|absent)$",
          "title": "Precondition Hash",
