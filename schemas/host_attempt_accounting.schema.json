{
  "$defs": {
    "HostAttemptReason": {
      "description": "Why a real Agent-host context did not become a settled work submission.\n\nThis is deliberately narrower than ``ReservationSettlement``.  A host\nattempt that failed before Core could ingest a work submission must never\nbe represented as a fabricated WorkSubmission or as an extra reservation.",
      "enum": [
        "dispatch_contract_failure",
        "submission_validation_failure",
        "execution_interrupted",
        "execution_repair"
      ],
      "title": "HostAttemptReason",
      "type": "string"
    },
    "MeasurementKind": {
      "enum": [
        "reported",
        "estimated",
        "unavailable"
      ],
      "title": "MeasurementKind",
      "type": "string"
    },
    "UsageAllowance": {
      "additionalProperties": false,
      "properties": {
        "active_wall_clock_ms": {
          "minimum": 0,
          "title": "Active Wall Clock Ms",
          "type": "integer"
        },
        "agent_calls": {
          "minimum": 0,
          "title": "Agent Calls",
          "type": "integer"
        },
        "candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "estimated_tokens": {
          "minimum": 0,
          "title": "Estimated Tokens",
          "type": "integer"
        },
        "proposals": {
          "default": 0,
          "minimum": 0,
          "title": "Proposals",
          "type": "integer"
        },
        "repairs": {
          "default": 0,
          "minimum": 0,
          "title": "Repairs",
          "type": "integer"
        }
      },
      "required": [
        "agent_calls",
        "estimated_tokens",
        "active_wall_clock_ms"
      ],
      "title": "UsageAllowance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append-only accounting for one Agent-host context outside Core ingest.\n\nThe record exists solely for a failed dispatch or a failed execution that\nwas repaired before a valid WorkSubmission could be accepted.  It cannot\ncarry proposals or candidates, and is attached to the owner run's single\nactive-session ledger.",
  "properties": {
    "accounting_id": {
      "minLength": 1,
      "title": "Accounting Id",
      "type": "string"
    },
    "agent_duration_ms": {
      "minimum": 0,
      "title": "Agent Duration Ms",
      "type": "integer"
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "context_id": {
      "minLength": 1,
      "title": "Context Id",
      "type": "string"
    },
    "duration_kind": {
      "$ref": "#/$defs/MeasurementKind"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "host_task_id": {
      "minLength": 1,
      "title": "Host Task Id",
      "type": "string"
    },
    "reason": {
      "$ref": "#/$defs/HostAttemptReason"
    },
    "reason_zh": {
      "minLength": 1,
      "title": "Reason Zh",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "role": {
      "minLength": 1,
      "title": "Role",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "token_count_kind": {
      "$ref": "#/$defs/MeasurementKind"
    },
    "usage": {
      "$ref": "#/$defs/UsageAllowance"
    },
    "work_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Id"
    }
  },
  "required": [
    "accounting_id",
    "run_id",
    "config_hash",
    "role",
    "host_task_id",
    "context_id",
    "reason",
    "usage",
    "token_count_kind",
    "agent_duration_ms",
    "duration_kind",
    "reason_zh",
    "evidence_refs",
    "recorded_at"
  ],
  "title": "HostAttemptAccounting",
  "type": "object"
}
