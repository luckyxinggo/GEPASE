{
  "$defs": {
    "ValidationIncompleteCase": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "const": "evidence_incomplete",
          "default": "evidence_incomplete",
          "title": "Disposition",
          "type": "string"
        },
        "role": {
          "enum": [
            "independent_grader",
            "comparator"
          ],
          "title": "Role",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "terminalization_id": {
          "title": "Terminalization Id",
          "type": "string"
        },
        "terminalization_ref": {
          "title": "Terminalization Ref",
          "type": "string"
        },
        "terminalization_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Terminalization Sha256",
          "type": "string"
        },
        "work_id": {
          "title": "Work Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "role",
        "work_id",
        "terminalization_id",
        "terminalization_ref",
        "terminalization_sha256"
      ],
      "title": "ValidationIncompleteCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fail-closed terminal projection for incomplete held-out role evidence.",
  "properties": {
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_run_summary_ref": {
      "title": "Candidate Run Summary Ref",
      "type": "string"
    },
    "candidate_run_summary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Run Summary Sha256",
      "type": "string"
    },
    "deployable": {
      "const": false,
      "default": false,
      "title": "Deployable",
      "type": "boolean"
    },
    "gate_eligible": {
      "const": false,
      "default": false,
      "title": "Gate Eligible",
      "type": "boolean"
    },
    "incomplete_cases": {
      "items": {
        "$ref": "#/$defs/ValidationIncompleteCase"
      },
      "minItems": 1,
      "title": "Incomplete Cases",
      "type": "array"
    },
    "required_task_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Task Ids",
      "type": "array"
    },
    "resolution_id": {
      "title": "Resolution Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_task_ids": {
      "items": {
        "type": "string"
      },
      "title": "Scored Task Ids",
      "type": "array"
    },
    "split": {
      "const": "validation",
      "default": "validation",
      "title": "Split",
      "type": "string"
    },
    "status": {
      "const": "validation_evidence_incomplete",
      "default": "validation_evidence_incomplete",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "resolution_id",
    "run_id",
    "candidate_id",
    "required_task_ids",
    "scored_task_ids",
    "incomplete_cases",
    "candidate_run_summary_ref",
    "candidate_run_summary_sha256"
  ],
  "title": "CandidateValidationIncompleteResolution",
  "type": "object"
}
