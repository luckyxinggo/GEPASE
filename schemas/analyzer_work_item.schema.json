{
  "$defs": {
    "AnalysisNodeHint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "path",
        "kind",
        "label"
      ],
      "title": "AnalysisNodeHint",
      "type": "object"
    },
    "AnalyzerEvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "deterministic_bundle_ref": {
          "title": "Deterministic Bundle Ref",
          "type": "string"
        },
        "execution_record_ref": {
          "title": "Execution Record Ref",
          "type": "string"
        },
        "failed_expectation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Failed Expectation Ids",
          "type": "array"
        },
        "failure_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderFailureKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "grader_feedback_zh": {
          "title": "Grader Feedback Zh",
          "type": "string"
        },
        "independent_grade_ref": {
          "title": "Independent Grade Ref",
          "type": "string"
        },
        "output_quality": {
          "maximum": 1,
          "minimum": 0,
          "title": "Output Quality",
          "type": "number"
        },
        "package_access_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Access Ref"
        },
        "task_correctness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Task Correctness",
          "type": "number"
        },
        "variant": {
          "enum": [
            "no-skill",
            "original"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "variant",
        "execution_record_ref",
        "deterministic_bundle_ref",
        "independent_grade_ref",
        "task_correctness",
        "output_quality",
        "failed_expectation_ids",
        "grader_feedback_zh"
      ],
      "title": "AnalyzerEvidenceSummary",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ProviderFailureKind": {
      "enum": [
        "invalid_submission",
        "duplicate",
        "timeout",
        "partial_artifact",
        "interrupted",
        "unsupported_capability",
        "task_failure",
        "environment_unavailable"
      ],
      "title": "ProviderFailureKind",
      "type": "string"
    },
    "SemanticConsumer": {
      "enum": [
        "failure_localization",
        "asi_explanation",
        "selector_top_k",
        "exploration_ordering",
        "patch_authorization",
        "target_set_expansion",
        "trusted_dependency_closure",
        "safety_closure",
        "merge_eligibility",
        "merge_conflict_resolution",
        "validation_gate"
      ],
      "title": "SemanticConsumer",
      "type": "string"
    },
    "SemanticEnrichmentScope": {
      "additionalProperties": false,
      "properties": {
        "allowed_nodes": {
          "items": {
            "$ref": "#/$defs/SemanticNodeContext"
          },
          "minItems": 2,
          "title": "Allowed Nodes",
          "type": "array"
        },
        "config": {
          "$ref": "#/$defs/SemanticHypothesisConfig"
        },
        "evidence_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Evidence Artifacts",
          "type": "array"
        },
        "failure_cluster_id": {
          "title": "Failure Cluster Id",
          "type": "string"
        },
        "failure_summary_zh": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Failure Summary Zh",
          "type": "string"
        },
        "package_id": {
          "title": "Package Id",
          "type": "string"
        },
        "package_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Snapshot Hash",
          "type": "string"
        },
        "prompt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_ref": {
          "title": "Prompt Ref",
          "type": "string"
        },
        "schema_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Hash",
          "type": "string"
        },
        "schema_ref": {
          "title": "Schema Ref",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "package_snapshot_hash",
        "failure_cluster_id",
        "failure_summary_zh",
        "evidence_artifacts",
        "allowed_nodes",
        "prompt_ref",
        "prompt_hash",
        "schema_ref",
        "schema_hash",
        "config"
      ],
      "title": "SemanticEnrichmentScope",
      "type": "object"
    },
    "SemanticHypothesisConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_consumers": {
          "default": [
            "failure_localization",
            "asi_explanation",
            "selector_top_k",
            "exploration_ordering"
          ],
          "items": {
            "$ref": "#/$defs/SemanticConsumer"
          },
          "title": "Allowed Consumers",
          "type": "array"
        },
        "allowed_relation_types": {
          "default": [
            "implements",
            "explains",
            "constrains",
            "consumes",
            "produces",
            "validates",
            "conflicts_with"
          ],
          "items": {
            "$ref": "#/$defs/SemanticRelationType"
          },
          "title": "Allowed Relation Types",
          "type": "array"
        },
        "analyzer_timeout_ms": {
          "default": 180000,
          "maximum": 600000,
          "minimum": 1,
          "title": "Analyzer Timeout Ms",
          "type": "integer"
        },
        "analyzer_token_budget": {
          "default": 12000,
          "maximum": 64000,
          "minimum": 1,
          "title": "Analyzer Token Budget",
          "type": "integer"
        },
        "config_id": {
          "default": "gh-p1-bounded-semantic-v1",
          "title": "Config Id",
          "type": "string"
        },
        "max_agent_calls": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Agent Calls",
          "type": "integer"
        },
        "max_allowed_nodes": {
          "default": 12,
          "maximum": 40,
          "minimum": 2,
          "title": "Max Allowed Nodes",
          "type": "integer"
        },
        "max_proposals_per_work": {
          "default": 6,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Proposals Per Work",
          "type": "integer"
        },
        "max_relations_per_node": {
          "default": 3,
          "maximum": 6,
          "minimum": 1,
          "title": "Max Relations Per Node",
          "type": "integer"
        },
        "max_relations_per_node_pair": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Relations Per Node Pair",
          "type": "integer"
        },
        "min_confidence": {
          "default": 0.45,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Confidence",
          "type": "number"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selector_weight_cap": {
          "default": 0.35,
          "maximum": 0.5,
          "minimum": 0,
          "title": "Selector Weight Cap",
          "type": "number"
        }
      },
      "title": "SemanticHypothesisConfig",
      "type": "object"
    },
    "SemanticNodeContext": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "path",
        "locator",
        "kind",
        "label",
        "content_hash",
        "excerpt"
      ],
      "title": "SemanticNodeContext",
      "type": "object"
    },
    "SemanticRelationType": {
      "enum": [
        "implements",
        "explains",
        "constrains",
        "consumes",
        "produces",
        "validates",
        "conflicts_with"
      ],
      "title": "SemanticRelationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analyzer_work_id": {
      "title": "Analyzer Work Id",
      "type": "string"
    },
    "baseline": {
      "$ref": "#/$defs/AnalyzerEvidenceSummary"
    },
    "comparator_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparator Ref"
    },
    "forbidden_inputs": {
      "default": [
        "candidate identity",
        "search history",
        "patch proposal",
        "grader conversation",
        "comparator conversation"
      ],
      "items": {
        "type": "string"
      },
      "title": "Forbidden Inputs",
      "type": "array"
    },
    "node_hints": {
      "items": {
        "$ref": "#/$defs/AnalysisNodeHint"
      },
      "title": "Node Hints",
      "type": "array"
    },
    "original": {
      "$ref": "#/$defs/AnalyzerEvidenceSummary"
    },
    "package_graph_ref": {
      "title": "Package Graph Ref",
      "type": "string"
    },
    "pair_id": {
      "title": "Pair Id",
      "type": "string"
    },
    "role": {
      "const": "analyzer",
      "default": "analyzer",
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_enrichment": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticEnrichmentScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "submission_schema_ref": {
      "title": "Submission Schema Ref",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "task_prompt": {
      "title": "Task Prompt",
      "type": "string"
    }
  },
  "required": [
    "analyzer_work_id",
    "task_id",
    "pair_id",
    "task_prompt",
    "baseline",
    "original",
    "package_graph_ref",
    "node_hints",
    "submission_schema_ref"
  ],
  "title": "AnalyzerWorkItem",
  "type": "object"
}
