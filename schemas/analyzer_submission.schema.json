{
  "$defs": {
    "FailureAnalysis": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "issue_zh": {
          "minLength": 1,
          "title": "Issue Zh",
          "type": "string"
        },
        "recommendation_zh": {
          "minLength": 1,
          "title": "Recommendation Zh",
          "type": "string"
        },
        "target_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Node Ids",
          "type": "array"
        },
        "variant": {
          "enum": [
            "no-skill",
            "original"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "analysis_id",
        "variant",
        "issue_zh",
        "evidence_refs",
        "target_node_ids",
        "confidence",
        "recommendation_zh"
      ],
      "title": "FailureAnalysis",
      "type": "object"
    },
    "RoleRunProvenance": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "host": {
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "host_task_id": {
          "minLength": 1,
          "title": "Host Task Id",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/UsageRecord"
        }
      },
      "required": [
        "host",
        "model",
        "context_id",
        "host_task_id",
        "usage",
        "started_at",
        "finished_at"
      ],
      "title": "RoleRunProvenance",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "token_count_kind": {
          "default": "unavailable",
          "enum": [
            "reported",
            "estimated",
            "unavailable"
          ],
          "title": "Token Count Kind",
          "type": "string"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analyses": {
      "items": {
        "$ref": "#/$defs/FailureAnalysis"
      },
      "title": "Analyses",
      "type": "array"
    },
    "analyzer_work_id": {
      "title": "Analyzer Work Id",
      "type": "string"
    },
    "role_run": {
      "$ref": "#/$defs/RoleRunProvenance"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submission_id": {
      "title": "Submission Id",
      "type": "string"
    },
    "summary_zh": {
      "minLength": 1,
      "title": "Summary Zh",
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "analyzer_work_id",
    "role_run",
    "analyses",
    "summary_zh"
  ],
  "title": "AnalyzerSubmission",
  "type": "object"
}
