{
  "$defs": {
    "FailureAnalysis": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "issue_zh": {
          "minLength": 1,
          "title": "Issue Zh",
          "type": "string"
        },
        "recommendation_zh": {
          "minLength": 1,
          "title": "Recommendation Zh",
          "type": "string"
        },
        "target_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Node Ids",
          "type": "array"
        },
        "variant": {
          "enum": [
            "no-skill",
            "original"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "analysis_id",
        "variant",
        "issue_zh",
        "evidence_refs",
        "target_node_ids",
        "confidence",
        "recommendation_zh"
      ],
      "title": "FailureAnalysis",
      "type": "object"
    },
    "RoleRunProvenance": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "host": {
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "host_task_id": {
          "minLength": 1,
          "title": "Host Task Id",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/UsageRecord"
        }
      },
      "required": [
        "host",
        "model",
        "context_id",
        "host_task_id",
        "usage",
        "started_at",
        "finished_at"
      ],
      "title": "RoleRunProvenance",
      "type": "object"
    },
    "SemanticNodeAnchor": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "span_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Hash"
        }
      },
      "required": [
        "node_id",
        "content_hash"
      ],
      "title": "SemanticNodeAnchor",
      "type": "object"
    },
    "SemanticRelationProposal": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "failure_cluster_id": {
          "minLength": 1,
          "title": "Failure Cluster Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "proposal_id": {
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "rationale_zh": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Rationale Zh",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/SemanticRelationType"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SemanticNodeAnchor"
        },
        "target": {
          "$ref": "#/$defs/SemanticNodeAnchor"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "source",
        "target",
        "relation_type",
        "task_id",
        "failure_cluster_id",
        "evidence_refs",
        "rationale_zh",
        "confidence"
      ],
      "title": "SemanticRelationProposal",
      "type": "object"
    },
    "SemanticRelationType": {
      "enum": [
        "implements",
        "explains",
        "constrains",
        "consumes",
        "produces",
        "validates",
        "conflicts_with"
      ],
      "title": "SemanticRelationType",
      "type": "string"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "token_count_kind": {
          "default": "unavailable",
          "enum": [
            "reported",
            "estimated",
            "unavailable"
          ],
          "title": "Token Count Kind",
          "type": "string"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analyses": {
      "items": {
        "$ref": "#/$defs/FailureAnalysis"
      },
      "title": "Analyses",
      "type": "array"
    },
    "analyzer_work_id": {
      "title": "Analyzer Work Id",
      "type": "string"
    },
    "role_run": {
      "$ref": "#/$defs/RoleRunProvenance"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_relation_proposals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SemanticRelationProposal"
      },
      "title": "Semantic Relation Proposals",
      "type": "array"
    },
    "submission_id": {
      "title": "Submission Id",
      "type": "string"
    },
    "summary_zh": {
      "minLength": 1,
      "title": "Summary Zh",
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "analyzer_work_id",
    "role_run",
    "analyses",
    "summary_zh"
  ],
  "title": "AnalyzerSubmission",
  "type": "object"
}
