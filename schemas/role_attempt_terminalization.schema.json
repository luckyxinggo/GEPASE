{
  "$defs": {
    "FunctionalRole": {
      "enum": [
        "independent_grader",
        "comparator",
        "analyzer"
      ],
      "title": "FunctionalRole",
      "type": "string"
    },
    "RoleAttemptFailure": {
      "additionalProperties": false,
      "description": "One already-accounted Agent-host attempt that produced no valid submission.",
      "properties": {
        "attempt_kind": {
          "$ref": "#/$defs/RoleAttemptKind"
        },
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "failure_kind": {
          "$ref": "#/$defs/RoleFailureKind"
        },
        "host_attempt_accounting_id": {
          "minLength": 1,
          "title": "Host Attempt Accounting Id",
          "type": "string"
        },
        "host_task_id": {
          "minLength": 1,
          "title": "Host Task Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "attempt_kind",
        "host_attempt_accounting_id",
        "host_task_id",
        "context_id",
        "evidence_sha256",
        "failure_kind",
        "source_refs"
      ],
      "title": "RoleAttemptFailure",
      "type": "object"
    },
    "RoleAttemptKind": {
      "enum": [
        "initial",
        "repair"
      ],
      "title": "RoleAttemptKind",
      "type": "string"
    },
    "RoleFailureKind": {
      "enum": [
        "timeout",
        "invalid_submission",
        "partial_artifact",
        "interrupted"
      ],
      "title": "RoleFailureKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Append-only terminal result for an exhausted non-Executor role work item.",
  "properties": {
    "allowed_repair_attempts": {
      "maximum": 2,
      "minimum": 0,
      "title": "Allowed Repair Attempts",
      "type": "integer"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/RoleAttemptFailure"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Attempts",
      "type": "array"
    },
    "disposition": {
      "enum": [
        "evidence_incomplete",
        "analysis_unavailable"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/FunctionalRole"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_penalty_applied": {
      "const": false,
      "default": false,
      "title": "Scoring Penalty Applied",
      "type": "boolean"
    },
    "synthetic_score_created": {
      "const": false,
      "default": false,
      "title": "Synthetic Score Created",
      "type": "boolean"
    },
    "synthetic_submission_created": {
      "const": false,
      "default": false,
      "title": "Synthetic Submission Created",
      "type": "boolean"
    },
    "synthetic_winner_created": {
      "const": false,
      "default": false,
      "title": "Synthetic Winner Created",
      "type": "boolean"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "terminalization_id": {
      "minLength": 1,
      "title": "Terminalization Id",
      "type": "string"
    },
    "terminalized_at": {
      "format": "date-time",
      "title": "Terminalized At",
      "type": "string"
    },
    "work_id": {
      "minLength": 1,
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "terminalization_id",
    "run_id",
    "task_id",
    "work_id",
    "role",
    "attempts",
    "allowed_repair_attempts",
    "disposition",
    "terminalized_at"
  ],
  "title": "RoleAttemptTerminalization",
  "type": "object"
}
