{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "title": "Assertion Id",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "measurements": {
          "additionalProperties": true,
          "title": "Measurements",
          "type": "object"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "assertion_id",
        "family",
        "passed",
        "weight"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Id"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generated_by": {
          "title": "Generated By",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "host_task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Task Id"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "origin": {
          "enum": [
            "static",
            "simulation",
            "agent-native",
            "assertion",
            "replay",
            "mock"
          ],
          "title": "Origin",
          "type": "string"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "submission_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submission Id"
        }
      },
      "required": [
        "origin",
        "provider_id",
        "generated_by"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    },
    "EvidenceTier": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3"
      ],
      "title": "EvidenceTier",
      "type": "string"
    },
    "ProviderFailureKind": {
      "enum": [
        "invalid_submission",
        "duplicate",
        "timeout",
        "partial_artifact",
        "interrupted",
        "unsupported_capability",
        "task_failure",
        "environment_unavailable"
      ],
      "title": "ProviderFailureKind",
      "type": "string"
    },
    "TaskScoreVector": {
      "additionalProperties": false,
      "properties": {
        "candidate_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Snapshot Hash",
          "type": "string"
        },
        "efficiency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Efficiency",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "output_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Output Quality",
          "type": "number"
        },
        "package_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Package Quality",
          "type": "number"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "reliability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reliability",
          "type": "number"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scoring_policy_ref": {
          "minLength": 1,
          "title": "Scoring Policy Ref",
          "type": "string"
        },
        "skill_gain": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Skill Gain",
          "type": "number"
        },
        "task_correctness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Task Correctness",
          "type": "number"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "variant": {
          "enum": [
            "no-skill",
            "original",
            "candidate"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "pair_id",
        "variant",
        "candidate_snapshot_hash",
        "task_correctness",
        "output_quality",
        "skill_gain",
        "reliability",
        "efficiency",
        "package_quality",
        "evidence_refs",
        "scoring_policy_ref"
      ],
      "title": "TaskScoreVector",
      "type": "object"
    },
    "TraceCompleteness": {
      "enum": [
        "none",
        "planned_only",
        "partial",
        "complete"
      ],
      "title": "TraceCompleteness",
      "type": "string"
    },
    "TraceStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        }
      },
      "required": [
        "sequence",
        "action"
      ],
      "title": "TraceStep",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "token_count_kind": {
          "default": "unavailable",
          "enum": [
            "reported",
            "estimated",
            "unavailable"
          ],
          "title": "Token Count Kind",
          "type": "string"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_root": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Root"
    },
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "assertion_results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AssertionResult"
      },
      "title": "Assertion Results",
      "type": "array"
    },
    "candidate_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Snapshot Hash",
      "type": "string"
    },
    "evidence_tier": {
      "$ref": "#/$defs/EvidenceTier"
    },
    "failure_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Detail"
    },
    "failure_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderFailureKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fixture_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixture Hash",
      "type": "string"
    },
    "host_model_snapshot": {
      "title": "Host Model Snapshot",
      "type": "string"
    },
    "observed_trace": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TraceStep"
      },
      "title": "Observed Trace",
      "type": "array"
    },
    "pair_id": {
      "title": "Pair Id",
      "type": "string"
    },
    "planned_trace": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TraceStep"
      },
      "title": "Planned Trace",
      "type": "array"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/EvidenceProvenance"
    },
    "provider_snapshot": {
      "title": "Provider Snapshot",
      "type": "string"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "skill_id": {
      "title": "Skill Id",
      "type": "string"
    },
    "source_record_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Record Refs",
      "type": "array"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "task_score_vector": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskScoreVector"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace_completeness": {
      "$ref": "#/$defs/TraceCompleteness"
    },
    "uncertainty": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Uncertainty",
      "type": "number"
    },
    "usage": {
      "$ref": "#/$defs/UsageRecord"
    },
    "variant": {
      "enum": [
        "no-skill",
        "original",
        "candidate"
      ],
      "title": "Variant",
      "type": "string"
    },
    "work_id": {
      "title": "Work Id",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "work_id",
    "pair_id",
    "task_id",
    "skill_id",
    "variant",
    "evidence_tier",
    "candidate_snapshot_hash",
    "prompt_hash",
    "fixture_hash",
    "policy_hash",
    "provider_snapshot",
    "host_model_snapshot",
    "seed",
    "trace_completeness",
    "provenance"
  ],
  "title": "EvaluationRecord",
  "type": "object"
}
