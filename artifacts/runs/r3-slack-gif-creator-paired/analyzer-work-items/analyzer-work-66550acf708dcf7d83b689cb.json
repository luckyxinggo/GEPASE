      "path": "SKILL.md"
    },
    {
      "kind": "instruction",
      "label": "**Add visual depth**:",
      "node_id": "node-cd8934896264951aa3d464d1",
      "path": "SKILL.md"
    },
    {
      "kind": "instruction",
      "label": "Use gradients for backgrounds (`create_gradient_background`)",
