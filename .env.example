# Copy this file to .env and fill credentials locally.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_OPENAI_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# Conservative cache-miss USD rates per 1M tokens; update from official pricing when needed.
DEEPSEEK_INPUT_COST_PER_MILLION=0.435
DEEPSEEK_OUTPUT_COST_PER_MILLION=0.87
